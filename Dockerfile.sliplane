# Sliplane-compatible build of emaildawg.
# Differs from the upstream Dockerfile by using a shell-capable Debian-slim
# final stage (instead of distroless) so docker-entrypoint.sh can inject the
# bbctl config from the EMAILDAWG_CONFIG_B64 env secret at startup.

# --- Builder stage ---
FROM golang:1.27-bookworm AS builder
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential libolm-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o emaildawg ./cmd/emaildawg

# --- Final runtime (Debian slim, has a shell) ---
FROM debian:bookworm-slim
# Doppler CLI (via gpg-dearmor keyring): entrypoint re-execs under `doppler run`
# when DOPPLER_TOKEN is set so EMAILDAWG_CONFIG_B64/PASSPHRASE come from Doppler
# (sliplane-services/prd_emaildawg) instead of raw Sliplane env vars. Backward
# compatible: with DOPPLER_TOKEN unset, the existing env-var path is used.
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends ca-certificates libolm3 tzdata coreutils curl gnupg \
    && curl -sLf --retry 3 --tlsv1.2 --proto "=https" 'https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key' \
       | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" \
       > /etc/apt/sources.list.d/doppler-cli.list \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends doppler unzip \
    && rm -rf /var/lib/apt/lists/*

# Bitwarden Secrets Manager CLI (bws). Homelab-standard for secrets — entrypoint
# re-execs under `bws run` when BWS_ACCESS_TOKEN is set (preferred over Doppler).
# Pinned to 2.0.0 to match the rest of the estate. Doppler kept as fallback so the
# migration can flip via env without a rebuild.
RUN curl -sLf --retry 3 --tlsv1.2 --proto "=https" \
       -o /tmp/bws.zip \
       'https://github.com/bitwarden/sdk-sm/releases/download/bws-v2.0.0/bws-x86_64-unknown-linux-gnu-2.0.0.zip' \
    && unzip -o /tmp/bws.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/bws \
    && rm -f /tmp/bws.zip \
    && bws --version

RUN useradd -m -u 1000 nonroot

COPY --from=builder /build/emaildawg /usr/bin/emaildawg
COPY docker-entrypoint.sh /usr/bin/docker-entrypoint.sh
RUN chmod +x /usr/bin/docker-entrypoint.sh

# Create the data dir and hand the app tree to the unprivileged user before
# dropping privileges (mkdir as nonroot would hit permission denied).
RUN mkdir -p /home/nonroot/app/data && chown -R nonroot:nonroot /home/nonroot/app

USER nonroot
WORKDIR /home/nonroot/app
VOLUME ["/home/nonroot/app/data"]

EXPOSE 29319
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
